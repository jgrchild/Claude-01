# Database (SQLite default, swap for postgres:// in production)
DATABASE_URL=sqlite:///gratitude.db

# Nightly notification time
NIGHTLY_HOUR=21
NIGHTLY_MINUTE=0
TIMEZONE=America/New_York

# Security – change this to any long random string
SECRET_KEY=change-me-to-a-random-string

# Push notifications (Web Push / VAPID)
# Generate these by running: python generate_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com
